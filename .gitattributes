# Route Unity's YAML-based asset formats through UnityYAMLMerge on conflict.
# This only takes effect for a dev who has configured the `unityyamlmerge`
# mergetool in their own global .gitconfig — see doc/DevProcess.md.
*.unity merge=unityyamlmerge
*.prefab merge=unityyamlmerge
*.asset merge=unityyamlmerge
 
